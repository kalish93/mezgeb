# Copy to .env.local for local development.

# PostgreSQL. Local: the docker-compose database. Vercel: the pooled Neon connection string
# (it ends in ?sslmode=require).
DATABASE_URL=postgresql://cone_user:cone_pass@localhost:5433/cone_ledger

# Password to open the app (one shared password). Required in production; without it the app stays locked.
# Locally it may be left empty (the app is then open). Changing it signs every device out.
APP_PASSWORD=
